<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GyroPad"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Gyro aiming untuk gamepad Bluetooth tanpa gyro"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mode koneksi" />

    <RadioGroup
        android:id="@+id/radioGroupMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioWifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="WiFi (UDP)" />

        <RadioButton
            android:id="@+id/radioUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="USB (ADB)" />
    </RadioGroup>

    <TextView
        android:id="@+id/labelIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="IP PC (server)" />

    <EditText
        android:id="@+id/editTextIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="192.168.1.100"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Port" />

    <EditText
        android:id="@+id/editTextPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="25565"
        android:inputType="number" />

    <TextView
        android:id="@+id/textUsbHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Mode USB: jalankan &quot;adb reverse tcp:25565 tcp:25565&quot; dulu di PC, lalu field IP di atas diabaikan (selalu 127.0.0.1)."
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonConnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Hubungkan ke PC" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Belum terhubung" />

    <TextView
        android:id="@+id/textPacketCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paket terkirim: 0" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#33000000" />

    <Switch
        android:id="@+id/switchGyro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aktifkan Gyro" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Sensitivitas Gyro" />

    <SeekBar
        android:id="@+id/seekBarSensitivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="35" />

    <Button
        android:id="@+id/buttonGyroHold"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:text="TAHAN untuk GYRO AIM (tes tanpa L1)" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Preview arah gyro (kalibrasi, bukan tampilan in-game)" />

    <com.gyropad.app.ui.CrosshairView
        android:id="@+id/crosshairView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:background="#11000000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#33000000" />

    <TextView
        android:id="@+id/textRumbleStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rumble dari game: tidak aktif" />

</LinearLayout>
</ScrollView>
